<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GamePath Condition="'$(GamePath)' == '' And Exists('$(HOME)/Library/Application Support/Steam/steamapps/common/Valheim')">$(HOME)/Library/Application Support/Steam/steamapps/common/Valheim</GamePath>
    <GamePath Condition="'$(GamePath)' == '' And '$(OS)' == 'Unix'">$(HOME)/.steam/steam/steamapps/common/Valheim</GamePath>
    <GamePath Condition="'$(GamePath)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Valheim</GamePath>
    <ManagedPath Condition="'$(ManagedPath)' == '' And Exists('$(GamePath)/Valheim.app')">$(GamePath)/Valheim.app/Contents/Resources/Data/Managed</ManagedPath>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$(GamePath)/valheim_Data/Managed</ManagedPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == ''">$(GamePath)/BepInEx/core</BepInExCorePath>
    <PublicizedPath Condition="'$(PublicizedPath)' == ''">$(ManagedPath)/publicized_assemblies</PublicizedPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.44.1" PrivateAssets="all" />
    <Reference Include="$(BepInExCorePath)/BepInEx.dll;$(BepInExCorePath)/0Harmony.dll" Private="false" />
    <Reference Include="$(ManagedPath)/UnityEngine*.dll;$(ManagedPath)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(PublicizedPath)/assembly_valheim_publicized.dll;$(PublicizedPath)/assembly_utils_publicized.dll;$(PublicizedPath)/assembly_postprocessing_publicized.dll;$(PublicizedPath)/SoftReferenceableAssets_publicized.dll;$(PublicizedPath)/Splatform_publicized.dll" Private="false" />
    <Reference Include="$(ManagedPath)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="ServerSync" HintPath="DLL/ServerSync.dll" Private="true" />
    <EmbeddedResource Include="assets/ebr_assetbundle" />
    <None Update="eb_settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
